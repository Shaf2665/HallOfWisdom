{
  "name": "@hall-of-wisdom/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral Hall of Wisdom communication contract: agent identity, tasks, runs, and normalized agent events.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=24.11.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:package-entry": "node verify-package-entry.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
