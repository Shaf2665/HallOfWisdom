# Copy this file to .env.local (which is gitignored) if you need to override
# the default Hall Core URL. The default (loopback) is correct for local
# development — see docs/architecture/0005-minimal-web-interface.md, "Local
# URL configuration". For remote access through a Cloudflare Tunnel, set this
# to Hall Core's public HTTPS origin instead (see docs/remote-access.md); the
# `.\start.ps1` launcher reads this same variable from the environment, so
# .env.local is only used for a manual `next build`/`next dev`.
NEXT_PUBLIC_HALL_CORE_URL=http://127.0.0.1:4310
