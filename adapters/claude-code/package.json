{
  "name": "@hall-of-wisdom/claude-code-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coding-agent adapter that executes the locally installed, subscription-authenticated Claude Code CLI non-interactively and translates its stream-json output into normalized Hall agent events.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=24.11.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:package-entry": "node verify-package-entry.mjs"
  },
  "dependencies": {
    "@hall-of-wisdom/agent-adapter-sdk": "workspace:*",
    "@hall-of-wisdom/protocol": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
